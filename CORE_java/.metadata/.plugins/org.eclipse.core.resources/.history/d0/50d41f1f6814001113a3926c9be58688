public class JavaApp {
	public static void execution() {
		String s1 = "java";
		System.out.println(s1);
		System.out.println(s1.charAt(0));// to access each character
		for (int i = 0;i<s1.length();i++) {
			System.out.println(s1.charAt(i)+ " - " + s1.codePointAt(i));
		}
	}
}



